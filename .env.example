# SOC Analisis Engine Environment Configuration
# Target Enterprise Blueprint based on Guo et al. (2026)

# API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Storage & Databases
DATABASE_URL=postgresql://soc_user:soc_password@localhost:5432/soc_db
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=socpassword123

# External Enrichment Sources
GLPI_API_URL=https://glpi.internal.soc/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
OPENCTI_API_URL=https://opencti.internal.soc/graphql
OPENCTI_API_KEY=

# External AI / LLM Settings (OpenAI, Azure OpenAI, Groq, External Ollama, vLLM)
# Provider options: 'openai', 'ollama'
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your_external_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=false

# Scheduled Knowledge Sync (Daily 01:00 Asia/Jakarta)
KB_SYNC_CRON="0 1 * * *"
KB_SYNC_TIMEZONE=Asia/Jakarta

# Scheduled Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE_MODE=cron
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_TIMEZONE=Asia/Jakarta
BACKUP_COMPONENTS=postgres,elasticsearch,neo4j,redis
BACKUP_RETENTION_DAYS=30
BACKUP_REPOSITORY_URI=
BACKUP_VERIFY_AFTER_RUN=true
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
